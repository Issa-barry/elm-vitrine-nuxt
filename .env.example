# Copiez ce fichier en .env pour le développement local (il est ignoré par
# git). En préprod/production/recette, ne créez jamais de .env.<env> commité :
# ces valeurs sont saisies directement dans le panneau Hostinger de chaque
# Web App déployée. Voir docs/environment.md pour le détail complet.

# ── Application (publique) ─────────────────────────────────────────────────
# Nom affiché (titres, manifest PWA — voir docs/pwa.md). Changez-le par
# environnement dans Hostinger : "Eau La Maman" en prod, "ELM Préprod" en
# préprod, etc.
NUXT_PUBLIC_APP_NAME=Eau La Maman
# Optionnel : si absent, la valeur de "version" dans package.json est
# utilisée automatiquement (voir config/runtime.ts).
NUXT_PUBLIC_APP_VERSION=
# local | preprod | recette | production — pilote le SEO (noindex hors
# production, voir server/routes/robots.txt.ts et app.vue) et le short_name
# du manifest PWA (voir docs/pwa.md).
NUXT_PUBLIC_ENVIRONMENT=local
# URL publique de CE site (canonique, robots.txt). Sans slash final.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── API publique (visible dans le navigateur) ──────────────────────────────
# URL du monolithe Laravel, sans slash final.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# ── Configuration serveur Nuxt (jamais exposée au navigateur) ──────────────
# URL utilisée uniquement par server/api/* et server/utils/* pour relayer
# certains appels vers Laravel. Peut être identique à NUXT_PUBLIC_API_BASE.
NUXT_MONOLITH_API_BASE=http://localhost:8000
# Jeton serveur-à-serveur pour les routes /api/public/* protégées par le
# middleware `vitrine.token` côté Laravel. Le backend ne l'exige pas encore
# à ce jour — laissez vide tant qu'il n'a pas été communiqué et qu'aucun
# appel réel ne l'utilise (voir docs/environment.md).
NUXT_VITRINE_SERVICE_TOKEN=

# Secret de scellement (chiffrement + signature) du cookie de session BFF qui
# porte le token Sanctum côté serveur Nuxt (server/utils/authSession.ts) —
# jamais exposé au navigateur. Obligatoire hors local (le serveur refuse de
# démarrer sans, voir server/plugins/validateRuntimeConfig.ts). >= 32
# caractères aléatoires, propre à chaque environnement (jamais réutilisé
# entre local/préprod/production). Générer avec : openssl rand -hex 32
NUXT_AUTH_SESSION_PASSWORD=
